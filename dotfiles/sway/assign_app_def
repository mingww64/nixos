# ==============================================================================
# Workspace Assignments & Window Focus Rules
# ==============================================================================

# Workspace 2: Web Browsers
assign [app_id="google-chrome"] 2
for_window [app_id="google-chrome"] focus

# Workspace 3: Code Editors
assign [app_id="antigravity"] 3
for_window [app_id="antigravity"] focus, opacity 0.95

# Workspace 4: Media & Entertainment
assign [title=".*([Tt]idal|[Hh]igh.[Tt]ide).*"] 4

# Workspace 5: Communication (Web Apps) & Connectivity
assign [app_id="chrome-.*-Default" title="(?i)(discord|teams|telegram|gmail)"] 5
for_window [app_id="chrome-.*-Default" title="(?i)(discord|teams|telegram|gmail)"] focus, opacity 0.95

assign [app_id="(?i)kdeconnect.*"] 5
assign [class="(?i)kdeconnect.*"] 5
assign [app_id="lan-mouse"] 5


# ==============================================================================
# Floating Window Rules
# ==============================================================================

# System Popups & GUI Utilities
for_window [app_id="pavucontrol"] floating enable, sticky enable, resize set width 550 px height 600px, move position cursor, move down 35, opacity 0.95
for_window [app_id="blueman-manager"] floating enable, resize set width 40 ppt height 30 ppt, opacity 0.95
for_window [class="Bluetooth-sendto" instance="bluetooth-sendto"] floating enable, opacity 0.95
for_window [app_id="org.corectrl.CoreCtrl"] floating enable, resize set width 60 ppt height 70 ppt, opacity 0.95
for_window [app_id="rquickshare"] floating enable
for_window [title="nmtui"] floating enable, resize set width 50 ppt height 70 ppt
for_window [title="htop"] floating enable, resize set width 50 ppt height 70 ppt
for_window [app_id="lxqt-openssh-askpass"] floating enable, resize set width 804 px height 207 px

# Terminals & File Managers
for_window [app_id="foot"] floating enable, border pixel 5, sticky enable, focus, opacity 0.85
for_window [app_id="filemanager"] floating enable, border pixel 5, sticky enable, focus, opacity 0.85

# Window roles / types that should float natively
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_role="About"] floating enable
for_window [title="File Operation Progress"] floating enable, border pixel 1, sticky enable, resize set width 40 ppt height 30 ppt
for_window [title="Picture in picture"] floating enable, sticky enable
for_window [title="Save File"] floating enable

# App launcher focus
for_window [app_id="ulauncher"] focus
for_window [class="Ulauncher"] focus


# ==============================================================================
# Inhibit Idle Rules
# ==============================================================================

# Browsers
for_window [app_id="google-chrome"] inhibit_idle fullscreen
for_window [class="(?i).*chrome.*"] inhibit_idle visible
for_window [app_id="(?i).*chrome.*"] inhibit_idle visible

# Media
for_window [class="(?i).*mpv.*"] inhibit_idle visible
for_window [app_id="(?i).*mpv.*"] inhibit_idle visible

# Code Editors
for_window [class="(?i).*antigravity.*"] inhibit_idle visible
for_window [app_id="(?i).*antigravity.*"] inhibit_idle visible
